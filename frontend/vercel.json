{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://palani-broilers-api.vercel.app/api/:path*"
    },
    {
      "source": "/comments",
      "destination": "/index.html"
    },
    {
      "source": "/comments/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
